{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-automation-tools.dev/schemas/ascc/v1alpha1/plugin-capability-token.json",
  "title": "ASCC plugin capability token claims",
  "description": "v1alpha1. The claims of the token the plugin host mints for a plugin, a JWT with typ plgcap+jwt and a lifetime of at most one hour (data contracts section 3). It names a plugin, not a person, and is not a delegation token. Unknown claims are refused. The typ header, the signature and the lifetime limit are outside this schema.",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "sub",
    "tenant",
    "iat",
    "exp",
    "jti",
    "ascc"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "type": "string",
      "minLength": 1
    },
    "sub": {
      "type": "string",
      "pattern": "^plg_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "jti": {
      "type": "string",
      "minLength": 1
    },
    "ascc": {
      "type": "object",
      "required": [
        "contract_version",
        "scopes",
        "epoch_min"
      ],
      "properties": {
        "v": {
          "description": "Token version (data contracts section 8).",
          "type": "integer",
          "minimum": 0
        },
        "connector_id": {
          "type": "string",
          "pattern": "^con_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^v[0-9]+(alpha|beta)?[0-9]*$"
        },
        "scopes": {
          "description": "Each scope ends in @self: the plugin's own namespace.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z_]+@self$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "network_hosts": {
          "description": "Lowercase DNS names: no scheme, port, userinfo, path, wildcard or IP literal.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "credential_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "epoch_min": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
