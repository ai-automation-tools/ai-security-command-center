{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-automation-tools.dev/schemas/ascc/v1alpha1/pdp-request.json",
  "title": "ASCC PDP request",
  "description": "v1alpha1. The body of POST /pdp/v1/decide (data contracts section 6). principal and resource are Cedar entity references, so their ids are the policy store's and not always a prefixed ULID. context is the action's Cedar context and is the only open object.",
  "type": "object",
  "required": [
    "tenant_id",
    "principal",
    "action",
    "resource"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object"
    },
    "token_jti": {
      "type": "string"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "additionalProperties": false
}
