{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-automation-tools.dev/schemas/ascc/v1alpha1/transaction-token.json",
  "title": "ASCC transaction token claims",
  "description": "v1alpha1. The claims of the ASCC transaction token, a JWT with typ txn+jwt (data contracts section 3). act follows RFC 8693: the outermost act is the current actor and each nested act a prior one. Claim names are the contract's own; unknown claims are refused, in ascc, act and cnf as well. The typ header and the signature are outside this schema.",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "sub",
    "tenant",
    "iat",
    "exp",
    "jti",
    "act",
    "ascc"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "type": "string",
      "minLength": 1
    },
    "sub": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "jti": {
      "type": "string",
      "minLength": 1
    },
    "act": {
      "$ref": "#/$defs/act"
    },
    "ascc": {
      "type": "object",
      "required": [
        "task_id",
        "session_id",
        "scope",
        "depth",
        "authority",
        "epoch_min"
      ],
      "properties": {
        "v": {
          "description": "Token version (data contracts section 8).",
          "type": "integer",
          "minimum": 0
        },
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^ses_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "purpose": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "budget_ref": {
          "type": "string"
        },
        "authority": {
          "type": "string",
          "enum": [
            "delegated",
            "service_grant"
          ]
        },
        "epoch_min": {
          "description": "A PEP with an older bundle must not accept the token for tier 2 or 3.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cnf": {
      "description": "Present only where proof of possession is supported. Exactly one binding.",
      "type": "object",
      "properties": {
        "jkt": {
          "description": "SHA-256 JWK thumbprint of the instance key, base64url.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "x5t#S256": {
          "description": "SHA-256 thumbprint of the SVID certificate, base64url.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "not": {
        "required": [
          "jkt",
          "x5t#S256"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "act": {
      "type": "object",
      "required": [
        "sub",
        "agent"
      ],
      "properties": {
        "sub": {
          "type": "string",
          "pattern": "^ain_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "agent": {
          "type": "string",
          "pattern": "^agt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "act": {
          "$ref": "#/$defs/act"
        }
      },
      "additionalProperties": false
    }
  }
}
